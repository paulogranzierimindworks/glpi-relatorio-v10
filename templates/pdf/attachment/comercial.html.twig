{#
 # Attachment, "Relatório Comercial": hours per category and the client's
 # tickets (same data as the on-screen client report).
 #}
<table width="100%" cellpadding="2" cellspacing="0">
  <tr>
    <td width="100%" style="border-bottom:0.6pt solid #cbd5e1;color:#005295;font-size:8pt;"><b>HORAS POR CATEGORIA</b></td>
  </tr>
</table>
<table width="100%" cellpadding="3" cellspacing="0" style="font-size:7.8pt;">
  <thead>
    <tr style="background-color:#005096;color:#ffffff;">
      <th width="80%" align="left"><b>CATEGORIA</b></th>
      <th width="20%" align="center"><b>HORAS</b></th>
    </tr>
  </thead>
  <tbody>
    {% for category in categories %}
    <tr style="background-color:{{ loop.index is odd ? '#ffffff' : '#f9fafb' }};">
      <td width="80%" align="left" style="border-bottom:0.3pt solid #e2e8f0;">{{ category.categoria }}</td>
      <td width="20%" align="center" style="border-bottom:0.3pt solid #e2e8f0;">{{ category.tempo_total_formatado }}</td>
    </tr>
    {% else %}
    <tr>
      <td width="100%" colspan="2" align="center" style="color:#94a3b8;">Nenhuma hora apontada no período.</td>
    </tr>
    {% endfor %}
    <tr style="background-color:#000e27;color:#ffffff;">
      <td width="80%" align="left"><b>Total</b></td>
      <td width="20%" align="center"><b>{{ total_trabalhado_formatado }}</b></td>
    </tr>
  </tbody>
</table>

{% if show_tickets %}
<br>
<table width="100%" cellpadding="2" cellspacing="0">
  <tr>
    <td width="100%" style="border-bottom:0.6pt solid #cbd5e1;color:#005295;font-size:8pt;"><b>CHAMADOS</b></td>
  </tr>
</table>
<table width="100%" cellpadding="3" cellspacing="0" style="font-size:7.2pt;">
  <thead>
    <tr style="background-color:#005096;color:#ffffff;">
      <th width="6%" align="center"><b>ID</b></th>
      <th width="9%" align="center"><b>TIPO</b></th>
      <th width="29%" align="left"><b>TÍTULO CHAMADO</b></th>
      <th width="16%" align="left"><b>CATEGORIA</b></th>
      <th width="14%" align="left"><b>ANALISTA</b></th>
      <th width="10%" align="center"><b>SOLUÇÃO</b></th>
      <th width="10%" align="center"><b>FECHAMENTO</b></th>
      <th width="6%" align="center"><b>HORAS</b></th>
    </tr>
  </thead>
  <tbody>
    {% for ticket in tickets %}
    <tr style="background-color:{{ loop.index is odd ? '#ffffff' : '#f9fafb' }};">
      <td width="6%" align="center" style="border-bottom:0.3pt solid #e2e8f0;color:#005096;"><b>{{ ticket.id }}</b></td>
      <td width="9%" align="center" style="border-bottom:0.3pt solid #e2e8f0;">{{ ticket.tipo }}</td>
      <td width="29%" align="left" style="border-bottom:0.3pt solid #e2e8f0;">{{ ticket.titulo|default('-') }}</td>
      <td width="16%" align="left" style="border-bottom:0.3pt solid #e2e8f0;">{{ ticket.categoria }}</td>
      <td width="14%" align="left" style="border-bottom:0.3pt solid #e2e8f0;">{{ ticket.tecnico }}</td>
      <td width="10%" align="center" style="border-bottom:0.3pt solid #e2e8f0;">{{ ticket.data_solucao_fmt }}</td>
      <td width="10%" align="center" style="border-bottom:0.3pt solid #e2e8f0;">{{ ticket.data_fechamento_fmt }}</td>
      <td width="6%" align="center" style="border-bottom:0.3pt solid #e2e8f0;">{{ ticket.tempo_trabalhado_formatado }}</td>
    </tr>
    {% else %}
    <tr>
      <td width="100%" colspan="8" align="center" style="color:#94a3b8;">Nenhum chamado registrado no período.</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}
