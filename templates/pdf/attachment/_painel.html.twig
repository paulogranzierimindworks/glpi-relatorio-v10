{#
 # Indicators panel of the attachment (the template's "PAINEL DE INDICADORES"),
 # included by painel.html.twig and justificativas.html.twig.
 #}
{% set edge = '0.9pt solid #005096' %}
{% set grid = '0.4pt solid #cbd5e1' %}
<table width="100%" cellpadding="5" cellspacing="0" style="font-size:8.2pt;">
  <tr>
    <td width="100%" colspan="6" align="center" style="border-top:{{ edge }};border-left:{{ edge }};border-right:{{ edge }};border-bottom:{{ edge }};color:#000e27;font-size:9pt;"><b>{{ panel_title|upper }}</b></td>
  </tr>
  <tr>
    <td width="15%" style="border-left:{{ edge }};border-right:0.4pt solid #005096;border-bottom:{{ edge }};color:#000e27;"><b>Período</b></td>
    <td width="85%" colspan="5" align="center" style="border-right:{{ edge }};border-bottom:{{ edge }};color:#000e27;"><b>{{ periodo }}</b></td>
  </tr>
  <tr>
    <td width="100%" colspan="6" align="center" style="background-color:#000e27;color:#ffffff;font-size:9pt;"><b>{{ band }}</b></td>
  </tr>
  <tr style="background-color:#205493;color:#ffffff;">
    <td width="10%" align="center" style="border-right:0.4pt solid #ffffff;"><b>ID</b></td>
    <td width="46%" align="left" style="border-right:0.4pt solid #ffffff;"><b>Indicador</b></td>
    <td width="14%" align="center" style="border-right:0.4pt solid #ffffff;"><b>Meta</b></td>
    <td width="10%" align="center" style="border-right:0.4pt solid #ffffff;"><b>Atendido</b></td>
    <td width="10%" align="center" style="border-right:0.4pt solid #ffffff;"><b>Não atend.</b></td>
    <td width="10%" align="center"><b>Indicador</b></td>
  </tr>
  {% for row in indicators %}
  {% set bottom = loop.last and not obs ? edge : grid %}
  <tr style="background-color:{{ loop.index is odd ? '#ffffff' : '#f8fafc' }};">
    <td width="10%" align="center" style="border-left:{{ edge }};border-right:{{ grid }};border-bottom:{{ bottom }};color:#005096;"><b>{{ row.id }}</b></td>
    <td width="46%" align="left" style="border-right:{{ grid }};border-bottom:{{ bottom }};color:#1e293b;">{{ row.indicador }}</td>
    <td width="14%" align="center" style="border-right:{{ grid }};border-bottom:{{ bottom }};color:#1e293b;"><span style="font-family:dejavusans;">&#8805;</span> {{ row.meta }}</td>
    <td width="10%" align="center" style="border-right:{{ grid }};border-bottom:{{ bottom }};color:#1e293b;">{{ row.atendido }}</td>
    <td width="10%" align="center" style="border-right:{{ grid }};border-bottom:{{ bottom }};color:#1e293b;">{{ row.nao_atendido }}</td>
    <td width="10%" align="center" style="border-right:{{ edge }};border-bottom:{{ bottom }};color:{{ row.cor }};"><b>{{ row.percentual_fmt }}</b></td>
  </tr>
  {% endfor %}
  {% if obs %}
  <tr>
    <td width="100%" colspan="6" align="center" style="border-left:{{ edge }};border-right:{{ edge }};border-bottom:{{ edge }};font-size:7.5pt;color:#334155;"><b>OBS:</b> {{ obs }}</td>
  </tr>
  {% endif %}
</table>
