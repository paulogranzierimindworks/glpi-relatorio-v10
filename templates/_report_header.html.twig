{#
 # Header card shared by both on-screen reports: eyebrow, title, period badge
 # and the PDF export action.
 #}
<div class="card mb-3">
   <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div>
         <div class="subheader">{{ eyebrow }}</div>
         <h2 class="mb-1">{{ title }}</h2>
         <span class="badge bg-blue-lt">
            <i class="ti ti-calendar-event me-1"></i>{{ date_start_fmt }} – {{ date_end_fmt }}
         </span>
      </div>

      {% if pdf_url is not empty %}
         <a class="btn btn-outline-secondary" href="{{ pdf_url }}" target="_blank" rel="noopener">
            <i class="ti ti-file-type-pdf"></i>
            <span>{{ __('Exportar PDF', 'relatorioglpicomercial') }}</span>
         </a>
      {% endif %}
   </div>
</div>
