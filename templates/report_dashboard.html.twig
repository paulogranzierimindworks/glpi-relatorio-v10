{#
 # On-screen "Dashboard de Chamados": SLA and type donuts, hours per category,
 # status KPIs and the detailed ticket table, using GLPI's own theme variables (light/dark follows the user's theme).
 # Rendered inline inside a regular GLPI page, so it is a fragment. Every style
 # is scoped under .rgc-dash so nothing leaks into the rest of GLPI. The donuts
 # are drawn by the Chartist build GLPI already ships (Html::requireJs('charts')).
 #}

<style>
   .rgc-dash { --rgc-panel: var(--tblr-bg-surface, var(--tblr-card-bg, transparent)); --rgc-border: var(--tblr-border-color, rgba(128, 128, 128, .3));
      --rgc-head: var(--tblr-bg-surface-tertiary, rgba(128, 128, 128, .15)); --rgc-stripe: var(--tblr-table-striped-bg, rgba(128, 128, 128, .08));
      --rgc-muted: var(--tblr-secondary, rgba(128, 128, 128, .9)); color: var(--tblr-body-color, inherit); }
   .rgc-dash * { box-sizing: border-box; }
   .rgc-dash-title { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .5rem; margin-bottom: .75rem; }
   .rgc-dash-title h2 { margin: 0; font-size: 1.15rem; }
   .rgc-dash-title small { color: var(--rgc-muted); }
   .rgc-panel { background: var(--rgc-panel); border: 1px solid var(--rgc-border); border-radius: var(--tblr-border-radius, .25rem); padding: .75rem; }
   .rgc-panel h3 { margin: 0 0 .5rem; font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--rgc-muted); }
   .rgc-empty { text-align: center; color: var(--rgc-muted); padding: 2rem 0; }
   .rgc-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .75rem; margin-bottom: 1rem; }
   .rgc-kpi { --rgc-accent: inherit; display: flex; flex-direction: column; gap: .15rem; background: var(--rgc-panel); border: 1px solid var(--rgc-border);
      border-radius: var(--tblr-border-radius, .25rem); padding: .6rem .9rem; }
   .rgc-kpi-label { font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--rgc-muted); }
   .rgc-kpi-value { font-size: 1.6rem; font-weight: 700; line-height: 1.2; color: var(--rgc-accent); }
   .rgc-kpi-info { --rgc-accent: var(--tblr-blue, #4299e1); }
   .rgc-kpi-warn { --rgc-accent: var(--tblr-orange, #f76707); }
   .rgc-kpi-ok { --rgc-accent: var(--tblr-green, #2fb344); }
   .rgc-kpi-bad { --rgc-accent: var(--tblr-red, #d63939); }
   .rgc-charts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-bottom: 1rem; }
   @media (max-width: 1399px) { .rgc-charts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
   @media (max-width: 767px) { .rgc-charts { grid-template-columns: 1fr; } }
   .rgc-charts .rgc-panel { display: flex; flex-direction: column; }
   .rgc-donut { position: relative; height: 200px; }
   .rgc-donut svg { display: block; margin: 0 auto; }
   .rgc-donut .ct-slice-donut { fill: none; }
   .rgc-donut-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none; line-height: 1.15; }
   .rgc-donut-total { font-size: 1.6rem; font-weight: 700; }
   .rgc-donut-caption { font-size: .65rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--rgc-muted); }
   .rgc-legend { list-style: none; margin: .75rem 0 0; padding: .5rem 0 0; border-top: 1px solid var(--rgc-border); font-size: .85rem; }
   .rgc-legend li { display: flex; align-items: center; gap: .5rem; padding: .15rem 0; }
   .rgc-legend .rgc-dot { width: .75rem; height: .75rem; border-radius: 50%; flex: none; }
   .rgc-legend .rgc-legend-value { margin-left: auto; white-space: nowrap; font-weight: 600; }
   .rgc-legend .rgc-legend-value small { font-weight: 400; color: var(--rgc-muted); }
   .rgc-hours-wrap { flex: 1; min-height: 0; max-height: 300px; overflow: auto; }
   .rgc-hours-wrap thead th { position: sticky; top: 0; z-index: 1; }
   .rgc-hours-wrap tfoot td { position: sticky; bottom: 0; }
   .rgc-table { width: 100%; border-collapse: collapse; font-size: .8rem; color: inherit; }
   .rgc-table th { background: var(--rgc-head); font-weight: 600; text-align: center; padding: .35rem .5rem; white-space: nowrap; border-bottom: 1px solid var(--rgc-border); }
   .rgc-table td { padding: .35rem .5rem; border-bottom: 1px solid var(--rgc-border); }
   .rgc-table tbody tr:nth-child(even) td { background: var(--rgc-stripe); }
   .rgc-table tbody tr:hover td { background: var(--tblr-table-hover-bg, var(--rgc-head)); }
   .rgc-table tfoot td { background: var(--rgc-head); font-weight: 700; }
   .rgc-cats td, .rgc-cats th { text-align: left; }
   .rgc-cats td:last-child, .rgc-cats th:last-child { text-align: center; white-space: nowrap; }
   .rgc-tickets-wrap { overflow-x: auto; }
   .rgc-tickets td { text-align: center; vertical-align: middle; }
   .rgc-tickets td.rgc-left { text-align: left; }
   .rgc-tickets td.rgc-nowrap { white-space: nowrap; }
   .rgc-sla-violado { color: var(--tblr-red, #d63939); font-weight: 600; }
   .rgc-sla-ok { color: var(--tblr-green, #2fb344); font-weight: 600; }
   .rgc-panel-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .5rem; margin-bottom: .5rem; }
   .rgc-panel-head h3 { margin: 0; text-align: left; }
   .rgc-panel-tools { display: flex; align-items: center; gap: .5rem; }
   .rgc-col-status { font-size: .75rem; color: var(--rgc-muted); }
   .rgc-colmenu { min-width: 280px; max-height: 60vh; overflow-y: auto; padding: .25rem 0; }
   .rgc-colmenu .rgc-colactions { display: flex; gap: .5rem; padding: .25rem 1rem .5rem; border-bottom: 1px solid var(--rgc-border); }
   .rgc-colmenu .rgc-colgroup { padding: .5rem 1rem .1rem; font-size: .7rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--rgc-muted); }
   .rgc-colmenu label.dropdown-item { display: flex; align-items: center; gap: .5rem; cursor: pointer; }
   .rgc-col-hidden { display: none !important; }
   .rgc-tickets tfoot td { text-align: center; }
   .rgc-tickets tfoot td.rgc-total-label { text-align: left; }
</style>

<div class="rgc-dash">
   <div class="rgc-dash-title">
      <h2>{{ __('Dashboard de Chamados', 'relatorioglpicomercial') }}</h2>
      <small>{{ date_start_fmt }} – {{ date_end_fmt }}</small>
   </div>

   <div class="rgc-kpis">
      {% for kpi in [
         {label: __('Total', 'relatorioglpicomercial'), value: kpis.total, css: '', hint: ''},
         {label: __('Em Atendimento', 'relatorioglpicomercial'), value: kpis.em_atendimento, css: 'rgc-kpi-info', hint: ''},
         {label: __('Pendente', 'relatorioglpicomercial'), value: kpis.pendente, css: 'rgc-kpi-warn', hint: ''},
         {label: __('Fechado', 'relatorioglpicomercial'), value: kpis.fechado, css: 'rgc-kpi-ok', hint: ''},
         {label: __('Violado', 'relatorioglpicomercial'), value: kpis.violado, css: 'rgc-kpi-bad', hint: __('SLA Solução', 'relatorioglpicomercial')},
         {label: __('No Prazo', 'relatorioglpicomercial'), value: kpis.no_prazo, css: 'rgc-kpi-ok', hint: __('SLA Solução', 'relatorioglpicomercial')},
         {label: __('Média de Satisfação', 'relatorioglpicomercial'), value: media_satisfacao, css: '', hint: ''}
      ] %}
         <div class="rgc-kpi {{ kpi.css }}"{% if kpi.hint %} title="{{ kpi.hint }}"{% endif %}>
            <div class="rgc-kpi-label">{{ kpi.label }}</div>
            <div class="rgc-kpi-value">{{ kpi.value }}</div>
         </div>
      {% endfor %}
   </div>

   <div class="rgc-charts">
      {% for chart in [
         {title: __('SLA Atendimento', 'relatorioglpicomercial'), series: sla_atendimento_series},
         {title: __('SLA Solução', 'relatorioglpicomercial'), series: sla_series},
         {title: __('Tipo do Chamado', 'relatorioglpicomercial'), series: tipo_series}
      ] %}
         <div class="rgc-panel">
            <h3>{{ chart.title }}</h3>
            {% if chart.series is not empty %}
               <div class="rgc-donut" data-caption="{{ __('chamados', 'relatorioglpicomercial') }}" data-series="{{ chart.series|json_encode|e('html_attr') }}"></div>
               <ul class="rgc-legend">
                  {% for item in chart.series %}
                     <li>
                        <span class="rgc-dot" style="background: {{ item.color }}"></span>
                        <span>{{ item.label }}</span>
                        <span class="rgc-legend-value">{{ item.pct }} <small>({{ item.value }})</small></span>
                     </li>
                  {% endfor %}
               </ul>
            {% else %}
               <div class="rgc-empty">{{ __('Sem dados', 'relatorioglpicomercial') }}</div>
            {% endif %}
         </div>
      {% endfor %}

      <div class="rgc-panel">
         <h3>{{ __('Horas Categorias', 'relatorioglpicomercial') }}</h3>
         <div class="rgc-hours-wrap">
            <table class="rgc-table rgc-cats">
               <thead>
                  <tr>
                     <th>{{ __('Categoria', 'relatorioglpicomercial') }}</th>
                     <th>{{ __('Total Horas', 'relatorioglpicomercial') }}</th>
                  </tr>
               </thead>
               <tbody>
                  {% for categoria in categorias %}
                     <tr>
                        <td>{{ categoria.categoria }}</td>
                        <td>{{ categoria.tempo_fmt }}</td>
                     </tr>
                  {% else %}
                     <tr>
                        <td colspan="2" class="rgc-empty">{{ __('Nenhuma hora apontada no período.', 'relatorioglpicomercial') }}</td>
                     </tr>
                  {% endfor %}
               </tbody>
               <tfoot>
                  <tr>
                     <td>{{ __('Total', 'relatorioglpicomercial') }}</td>
                     <td style="text-align: center">{{ total_periodo_fmt }}</td>
                  </tr>
               </tfoot>
            </table>
         </div>
      </div>
   </div>


   {% set visible_columns = columns|filter(c => c.visible) %}
   {% set first_visible = (visible_columns|first).key %}
   <div class="rgc-panel" id="rgc-tickets-panel"
        data-columns-url="{{ columns_url }}"
        data-defaults="{{ default_columns|json_encode|e('html_attr') }}"
        data-total-label="{{ __('Total', 'relatorioglpicomercial') }}"
        data-msg-saved="{{ __('Preferência salva', 'relatorioglpicomercial') }}"
        data-msg-error="{{ __('Não foi possível salvar a preferência', 'relatorioglpicomercial') }}">
      <div class="rgc-panel-head">
         <h3>{{ __('Chamados', 'relatorioglpicomercial') }}</h3>
         <div class="rgc-panel-tools">
            <span class="rgc-col-status" role="status"></span>
            <div class="dropdown">
               <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle"
                       data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                  <i class="ti ti-columns"></i> {{ __('Colunas', 'relatorioglpicomercial') }}
               </button>
               <div class="dropdown-menu dropdown-menu-end rgc-colmenu">
                  <div class="rgc-colactions">
                     <button type="button" class="btn btn-sm btn-outline-secondary" data-rgc-action="all">{{ __('Marcar todas', 'relatorioglpicomercial') }}</button>
                     <button type="button" class="btn btn-sm btn-outline-secondary" data-rgc-action="defaults">{{ __('Restaurar padrão', 'relatorioglpicomercial') }}</button>
                  </div>
                  {% for group_key, group_label in column_groups %}
                     <div class="rgc-colgroup">{{ group_label }}</div>
                     {% for col in columns|filter(c => c.group == group_key) %}
                        <label class="dropdown-item" title="{{ col.source }}">
                           <input type="checkbox" class="form-check-input m-0 rgc-col-toggle" value="{{ col.key }}"{{ col.visible ? ' checked' : '' }}>
                           <span>{{ col.label }}</span>
                        </label>
                     {% endfor %}
                  {% endfor %}
               </div>
            </div>
         </div>
      </div>
      <div class="rgc-tickets-wrap">
         <table class="rgc-table rgc-tickets">
            <thead>
               <tr>
                  {% for col in columns %}
                     <th data-col="{{ col.key }}" title="{{ col.source }}"{{ col.visible ? '' : ' class="rgc-col-hidden"' }}>{{ col.label }}</th>
                  {% endfor %}
               </tr>
            </thead>
            <tbody>
               {% for row in rows %}
                  <tr>
                     {% for col in columns %}
                        {% set css = col.class ~ (col.visible ? '' : ' rgc-col-hidden') %}
                        {% if col.key in ['sla', 'sla_atendimento'] %}
                           {% set sla_value = row[col.field] %}
                           {% set css = css ~ (sla_value == 'Violado' ? ' rgc-sla-violado' : (sla_value == 'No prazo' ? ' rgc-sla-ok' : '')) %}
                        {% endif %}
                        <td data-col="{{ col.key }}" class="{{ css }}">
                           {%- if col.key == 'id' and can_link_item -%}
                              <a href="{{ 'Ticket'|itemtype_form_path(row.id) }}" target="_blank" rel="noopener">{{ row.id }}</a>
                           {%- else -%}
                              {{ row[col.field] }}
                           {%- endif -%}
                        </td>
                     {% endfor %}
                  </tr>
               {% else %}
                  <tr data-rgc-empty>
                     <td colspan="{{ visible_columns|length }}" class="rgc-empty">{{ __('Nenhum chamado encontrado para os filtros informados.', 'relatorioglpicomercial') }}</td>
                  </tr>
               {% endfor %}
            </tbody>
            <tfoot>
               <tr>
                  {% for col in columns %}
                     <td data-col="{{ col.key }}" class="{{ col.visible ? '' : 'rgc-col-hidden' }}{{ col.key == first_visible and col.key != 'periodo' ? ' rgc-total-label' : '' }}">
                        {%- if col.key == 'periodo' -%}
                           {{ total_periodo_fmt }}
                        {%- elseif col.key == first_visible -%}
                           {{ __('Total', 'relatorioglpicomercial') }}
                        {%- endif -%}
                     </td>
                  {% endfor %}
               </tr>
            </tfoot>
         </table>
      </div>
   </div>
</div>

<script>
   (function () {
      var panel = document.getElementById('rgc-tickets-panel');
      if (!panel) {
         return;
      }

      var table = panel.querySelector('.rgc-tickets');
      var status = panel.querySelector('.rgc-col-status');
      var toggles = Array.prototype.slice.call(panel.querySelectorAll('.rgc-col-toggle'));
      var defaults = [];
      try {
         defaults = JSON.parse(panel.getAttribute('data-defaults') || '[]');
      } catch (e) {}
      var saveTimer = null;
      var statusTimer = null;

      function selectedKeys() {
         return toggles.filter(function (t) { return t.checked; }).map(function (t) { return t.value; });
      }

      function refreshFooter() {
         var labelCell = null;
         table.querySelectorAll('tfoot td').forEach(function (td) {
            td.classList.remove('rgc-total-label');
            if (td.getAttribute('data-col') !== 'periodo') {
               td.textContent = '';
            }
            if (labelCell === null && !td.classList.contains('rgc-col-hidden')) {
               labelCell = td;
            }
         });
         if (labelCell !== null && labelCell.getAttribute('data-col') !== 'periodo') {
            labelCell.textContent = panel.getAttribute('data-total-label');
            labelCell.classList.add('rgc-total-label');
         }
      }

      function apply() {
         var keys = selectedKeys();
         toggles.forEach(function (t) {
            table.querySelectorAll('[data-col="' + t.value + '"]').forEach(function (cell) {
               cell.classList.toggle('rgc-col-hidden', keys.indexOf(t.value) === -1);
            });
         });
         var empty = table.querySelector('tr[data-rgc-empty] td');
         if (empty) {
            empty.setAttribute('colspan', keys.length);
         }
         refreshFooter();
      }

      function say(message) {
         status.textContent = message;
         clearTimeout(statusTimer);
         statusTimer = setTimeout(function () { status.textContent = ''; }, 2500);
      }

      function save() {
         clearTimeout(saveTimer);
         saveTimer = setTimeout(function () {
            var body = new URLSearchParams();
            body.append('save', '1');
            selectedKeys().forEach(function (key) { body.append('columns[]', key); });

            fetch(panel.getAttribute('data-columns-url'), {
               method: 'POST',
               credentials: 'same-origin',
               headers: {
                  'X-Requested-With': 'XMLHttpRequest',
                  'X-Glpi-Csrf-Token': typeof getAjaxCsrfToken === 'function' ? getAjaxCsrfToken() : ''
               },
               body: body
            }).then(function (response) {
               say(panel.getAttribute(response.ok ? 'data-msg-saved' : 'data-msg-error'));
            }).catch(function () {
               say(panel.getAttribute('data-msg-error'));
            });
         }, 400);
      }

      function setSelection(keys) {
         toggles.forEach(function (t) { t.checked = keys.indexOf(t.value) !== -1; });
         apply();
         save();
      }

      toggles.forEach(function (t) {
         t.addEventListener('change', function () {
            if (selectedKeys().length === 0) {
               t.checked = true;
               return;
            }
            apply();
            save();
         });
      });

      panel.querySelectorAll('[data-rgc-action]').forEach(function (button) {
         button.addEventListener('click', function () {
            if (button.getAttribute('data-rgc-action') === 'all') {
               setSelection(toggles.map(function (t) { return t.value; }));
            } else {
               setSelection(defaults);
            }
         });
      });
   })();
</script>

<script>
   window.addEventListener('load', function () {
      if (typeof Chartist === 'undefined') {
         return;
      }
      document.querySelectorAll('.rgc-dash .rgc-donut').forEach(function (el) {
         var series = [];
         try {
            series = JSON.parse(el.getAttribute('data-series') || '[]');
         } catch (e) {
            return;
         }
         if (!series.length) {
            return;
         }

         var width = 34;
         var chart = new Chartist.Pie(el, {
            labels: series.map(function (s) { return s.label; }),
            series: series.map(function (s) { return s.value; })
         }, {
            donut: true,
            donutWidth: width,
            showLabel: false,
            chartPadding: 8
         });

         var total = series.reduce(function (sum, s) { return sum + s.value; }, 0);
         var center = document.createElement('div');
         center.className = 'rgc-donut-center';
         var totalEl = document.createElement('span');
         totalEl.className = 'rgc-donut-total';
         totalEl.textContent = total;
         var captionEl = document.createElement('span');
         captionEl.className = 'rgc-donut-caption';
         captionEl.textContent = el.getAttribute('data-caption') || '';
         center.appendChild(totalEl);
         center.appendChild(captionEl);
         el.appendChild(center);

         chart.on('draw', function (context) {
            if (context.type === 'slice') {
               context.element.attr({
                  style: 'stroke: ' + series[context.index].color + '; stroke-width: ' + width + 'px'
               });
            }
         });
      });
   });
</script>
